# Copy this file to .env and fill in real values. Never commit .env.

# Your real Anthropic API key. This never leaves the server.
ANTHROPIC_API_KEY=sk-ant-...

# The shared passcode participants enter in the extension. Rotate this to
# cut off access to everyone at once.
STUDY_CODE=change-me

# Required: the shared first-turn assessment for the sycophancy conditions
# (every skill that mentions INITIAL_VIEW). One general sentence pointing
# toward the real bug's area, never its location or fix. The server refuses
# to start without it.
INITIAL_VIEW=The issue is likely in how the result is calculated when there is less data than expected.

# Optional overrides
PORT=3000
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=4096

# Optional: where the .claude/skills directory lives, if not the default
# (../.claude/skills relative to this server's project root).
# SKILLS_DIR=/path/to/.claude/skills
